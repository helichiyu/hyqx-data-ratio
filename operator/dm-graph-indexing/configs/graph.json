{
  "version": "0.1.0",
  "status": "provisional",
  "statusNote": "S6 联调初值：本体/KG/词表未提供（H-11），实体/关系用可解释规则抽取；Neo4j/FAISS 服务由平台部署（Q-07）。",
  "entities": {
    "patterns": {
      "date": ["\\d{4}-\\d{2}-\\d{2}", "\\d{4}年\\d{1,2}月(?:\\d{1,2}日)?"],
      "number": ["\\d+(?:\\.\\d+)?"],
      "org": ["[\\u4e00-\\u9fa5]{2,20}(?:公司|大学|研究院|委员会|中心|集团|银行|政府|学院)"],
      "quoted": ["“[^”]{2,20}”", "\"[^\"]{2,20}\""]
    },
    "minTermLength": 2,
    "maxEntitiesPerRecord": 20,
    "_source": "规则抽取（日期/数字/机构后缀/引号术语），非本体实体链接；标 rule_based=true"
  },
  "relations": {
    "recordLabel": "ABOUT",
    "recordEntity": "MENTIONS",
    "labelParent": "SUBCLASS_OF",
    "cooccurrence": "CO_OCCURS",
    "maxCooccurrencePairsPerRecord": 20,
    "_source": "记录-标签、记录-实体、一级-二级标签、同记录实体共现"
  },
  "vector": {
    "relativePath": "vectors.npy",
    "idsFile": "vector_ids.jsonl",
    "dimension": 768,
    "normalize": "l2",
    "topK": 10,
    "queryCount": 20,
    "recallK": [1, 5, 10],
    "nlist": 16,
    "nprobe": 4,
    "seed": 42,
    "_source": "复用 OP-03 bge 向量；IVF 近似检索（MiniBatchKMeans 固定 seed），recall@k 以精确内积为金标准"
  },
  "services": {
    "neo4jUrlEnv": "NEO4J_URL",
    "faissUrlEnv": "FAISS_URL",
    "_source": "服务地址由环境注入；算子只产导入文件/索引文件，不部署服务"
  },
  "limits": {"maxRecords": 1000000, "maxEntities": 500000, "maxEdges": 2000000}
}
