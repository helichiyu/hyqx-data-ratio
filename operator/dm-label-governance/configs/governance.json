{
  "version": "0.1.0",
  "status": "provisional",
  "statusNote": "S2 联调初值；冲突/低置信/PII 规则待人工确认（H-05）。",
  "tree": {
    "relativePath": "baseline/tree-snapshot.json",
    "spaces": ["content", "domain", "ability"]
  },
  "rules": {
    "minConfidence": 0.25,
    "smallMargin": 0.01,
    "nearestNodeMaxDistance": 3,
    "maxSuggestionsPerRecord": 10,
    "_source": "联调初值：低置信 <0.25；top1-top2 <0.01；编辑距离 ≤3 才给最近节点建议"
  },
  "pii": {
    "enabled": true,
    "patterns": {
      "email": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "mobile_cn": "(?<!\\d)1[3-9]\\d{9}(?!\\d)",
      "id_card_cn": "(?<!\\d)\\d{17}[\\dXx](?!\\d)",
      "bank_card": "(?<!\\d)\\d{16,19}(?!\\d)"
    },
    "_source": "联调初值：常见联系方式/证件/银行卡正则，仅用于提示，不做自动脱敏"
  },
  "limits": {
    "maxRecords": 100000
  }
}
