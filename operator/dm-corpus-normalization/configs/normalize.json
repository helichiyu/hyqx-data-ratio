{
  "version": "0.1.0",
  "status": "provisional",
  "statusNote": "S1 联调初值；分区、去重阈值与标准格式待 S1 评审/业务确认。",
  "partition": {
    "keys": ["modal", "source", "dt"],
    "rowGroupSize": 65536,
