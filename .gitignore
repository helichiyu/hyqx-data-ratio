# 嵌套的独立业务仓库，各自拥有独立 Git 历史，不纳入本仓库
/hsmty-module-dm-server/
/hsmty-web/

# 算子运行期与构建产物
operator/runtime/
runtime/
dist/
*.tar.gz
.env

# 模型权重不进 git（允许 .gitkeep、SHA256SUMS 与说明文件）
operator/weights/*
!operator/weights/.gitkeep
!operator/weights/SHA256SUMS
!operator/weights/README.md
!operator/weights/shared/
!operator/weights/shared/.gitkeep

# Python 缓存
__pycache__/
*.pyc
.pytest_cache/
